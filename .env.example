# Optional, public build settings for Umbral. Nothing here is a secret; never put credentials in a VITE_ variable.
# Copy to .env.local only if you need them.

# Base URL of the optional read-only Umbral API (worker/). Leave empty to use the bundled data only.
VITE_UMBRAL_API=

# Where processed image chips are served from. Leave empty to use the app's own address.
VITE_UMBRAL_ASSET_BASE=
